Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Tianditu satellite1
        - /odom TF1
        - /Chart Markers1
      Splitter Ratio: 0.5
    Tree Height: 700
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.72
      Blocks: 3
      Class: rviz_satellite/AerialMap
      Draw Behind: true
      Enabled: true
      Name: Tianditu satellite
      Object URI: "https://t0.tianditu.gov.cn/img_w/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=img&STYLE=default&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&tk={TIANDITU_TK}"
      TF tolerance: 0.1
      Timeout: 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fix
      Value: true
      Zoom: 16
    # Display only odom axes; the TF display also lists every vessel link.
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 10
      Name: odom TF
      Radius: 0.3
      Reference Frame: odom
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic: /robot_description
      Enabled: true
      Name: USV model
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.5
      Name: USV path
      Offset:
        X: 0
        Y: 0
        Z: 0.1
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /USV_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 80; 255; 80
      Enabled: true
      Head Diameter: 0.18
      Head Length: 0.12
      Length: 0.12
      Line Style: Billboards
      Line Width: 0.4
      Name: Mission waypoints
      Offset:
        X: 0
        Y: 0
        Z: 0.18
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 220; 255
      Enabled: true
      Head Diameter: 0.15
      Head Length: 0.1
      Length: 0.1
      Line Style: Billboards
      Line Width: 0.35
      Name: Local planner B-spline
      Offset:
        X: 0
        Y: 0
        Z: 0.25
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.08
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planning/bspline_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Chart Markers
      Queue Size: 10
      Namespaces:
        s57/ACHARE: true
        s57/BERTHS: true
        s57/BOYSPP: true
        s57/BRIDGE: true
        s57/BUAARE: true
        s57/BUISGL: true
        s57/CBLOHD: true
        s57/CRANES: true
        s57/CURENT: true
        s57/DAMCON: true
        s57/DEPCNT: true
        s57/DEPARE: true
        s57/DISMAR: true
        s57/FLODOC: true
        s57/Generic: true
        s57/LIGHT: true
        s57/LIGHTS: true
        s57/LNDARE: true
        s57/LNDRGN: true
        s57/LNDMRK: true
        s57/M_NPUB: true
        s57/M_NSYS: true
        s57/M_QUAL: true
        s57/PONTON: true
        s57/PRCARE: true
        s57/ROADWY: true
        s57/RESARE: true
        s57/SLCONS: true
        s57/SLOTOP: true
        s57/TOPMAR: true
        s57/TSELNE: true
        s57/TSSLPT: true
        s57/TSSLPT_DIRECTION: false
        s57/TSSBND: true
        s57/VEGATN: true
        s57/brgare: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /chart_markers
    - Alpha: 1
      Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Channel Direction Markers
      Queue Size: 10
      Namespaces:
        channel_direction_arrow: true
        same_direction_lane: true
        opposite_direction_lane: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /channel_navigation_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Simulated Perception
      Queue Size: 10
      Namespaces:
        perception_radius: true
        detected_obstacle: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception_markers
      Value: true
    - Alpha: 0.62
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: Channel Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /channel_costmap
  Enabled: true
  Global Options:
    Background Color: 48; 50; 52
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Enable Stereo Rendering: false
      Invert Z Axis: false
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 2500
      Target Frame: <Fixed Frame>
      Value: true
      X: 0
      Y: 0
      Z: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
  X: 80
  Y: 40
