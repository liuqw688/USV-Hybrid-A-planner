<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_map_tools</name>
  <version>0.1.0</version>
  <description>C++ RViz tools for chart editing, berth and reef design, and safe bidirectional fairway generation.</description>
  <maintainer email="sus@example.com">sus</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tinyxml2_vendor</depend>
  <depend>usv_map</depend>
  <depend>libgeos-dev</depend>
  <depend>libgdal-dev</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_satellite</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
